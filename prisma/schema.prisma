generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  GROUPS_SINGLE_ELIM
  GROUPS_DOUBLE_ELIM
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  FINISHED
}

enum TeamStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchBracket {
  GROUP
  WINNERS
  LOSERS
  GRAND_FINAL
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
}

enum MatchSlot {
  HOME
  AWAY
}

enum CardType {
  YELLOW
  RED
}

enum SportType {
  FUTEBOL_CAMPO
  FUTSAL
  FUTEBOL_7
  HANDEBOL
  VOLEIBOL
  BASQUETE
  TENIS_DE_MESA
}

enum PlanTier {
  START
  PRO
  LIGA
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum PaymentType {
  MONTHLY
  PER_TOURNAMENT
}

enum PixTransactionKind {
  TEAM_REGISTRATION
  SUBSCRIPTION
}

enum PixTransactionStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  tournaments   Tournament[]
  subscriptions Subscription[]
}

/// An organizer's plan purchase. MONTHLY subscriptions expire after ~30 days
/// and must be renewed manually (Efí Pix has no native recurring billing).
/// PER_TOURNAMENT (Start avulso) never expires — it's a one-tournament
/// credit consumed by creating a tournament, not a calendar window.
model Subscription {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  plan        PlanTier
  status      SubscriptionStatus @default(PENDING)
  paymentType PaymentType
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime           @default(now())

  pixTransactions PixTransaction[]

  @@index([userId, status])
}

/// A single PIX charge, either for a team's paid registration or for a
/// plan purchase. Never trust `status` from a webhook alone — always
/// re-confirm against Efí before flipping it to PAID (see src/lib/pix.ts).
model PixTransaction {
  id             String             @id @default(cuid())
  kind           PixTransactionKind
  tournamentId   String?
  tournament     Tournament?        @relation(fields: [tournamentId], references: [id])
  teamId         String?            @unique
  team           Team?              @relation(fields: [teamId], references: [id])
  subscriptionId String?
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id])

  amountCents       Int
  platformFeeCents  Int                  @default(0)
  status            PixTransactionStatus @default(PENDING)
  txid              String               @unique
  qrCode            String?
  qrCodeImageBase64 String?              @db.Text
  locId             Int?
  paidAt            DateTime?
  createdAt         DateTime             @default(now())

  @@index([status])
}

model Tournament {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  logoUrl     String?
  format      TournamentFormat
  status      TournamentStatus @default(DRAFT)
  sportType   SportType        @default(FUTEBOL_CAMPO)
  startDate   DateTime?
  endDate     DateTime?

  /// Team registration fee in cents, organizer-defined. Null/0 = free.
  /// Only settable when the organizer's plan allows charging (Pro/Liga).
  registrationFeeCents Int?

  /// Deadline for athlete transfer requests (Liga plan only). Null = no
  /// automatic cutoff — the organizer decides case by case.
  transferDeadline DateTime?

  pointsWin  Int @default(3)
  pointsDraw Int @default(1)
  pointsLoss Int @default(0)

  numGroups       Int?
  advancePerGroup Int?
  tiebreakerOrder Json?

  championTeamId String? @unique
  championTeam   Team?   @relation("Champion", fields: [championTeamId], references: [id])

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  venues           Venue[]
  teams            Team[]            @relation("TournamentTeams")
  groups           Group[]
  matches          Match[]
  pixTransactions  PixTransaction[]
  transferRequests TransferRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String

  matches Match[]
}

model Team {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation("TournamentTeams", fields: [tournamentId], references: [id], onDelete: Cascade)

  name         String
  logoUrl      String?
  managerName  String
  contactPhone String?
  contactEmail String?

  status TeamStatus @default(PENDING)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])
  seed    Int?

  players        Player[]
  homeMatches    Match[]           @relation("HomeTeam")
  awayMatches    Match[]           @relation("AwayTeam")
  goals          Goal[]
  cards          Card[]
  baskets        Basket[]
  fouls          Foul[]
  championOf     Tournament?       @relation("Champion")
  pixTransaction PixTransaction?
  transfersFrom  TransferRequest[] @relation("TransferFrom")
  transfersTo    TransferRequest[] @relation("TransferTo")

  createdAt DateTime @default(now())

  @@index([tournamentId, status])
}

/// A permanent, cross-tournament person record. Reused across different
/// teams/tournaments when the same CPF ("document") registers again —
/// this is what a transfer moves between teams, not the Player row itself.
model Athlete {
  id        String    @id @default(cuid())
  name      String
  document  String?   @unique
  birthDate DateTime?
  createdAt DateTime  @default(now())

  players          Player[]
  transferRequests TransferRequest[]
}

/// A roster slot: one athlete's participation on one team within one
/// tournament. Goals/cards/etc. stay attached to this row even after the
/// athlete transfers out — `active` marks whether it's the athlete's
/// current team for súmula "select player" purposes.
model Player {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  name        String
  shirtNumber Int?
  position    String?
  birthDate   DateTime?
  active      Boolean   @default(true)

  goals   Goal[]
  cards   Card[]
  baskets Basket[]
  fouls   Foul[]
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A team-initiated, organizer-approved request to move an athlete to a
/// different team within the same tournament, before `Tournament.transferDeadline`.
model TransferRequest {
  id           String                @id @default(cuid())
  tournamentId String
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      Athlete               @relation(fields: [athleteId], references: [id])
  fromTeamId   String?
  fromTeam     Team?                 @relation("TransferFrom", fields: [fromTeamId], references: [id])
  toTeamId     String
  toTeam       Team                  @relation("TransferTo", fields: [toTeamId], references: [id])
  status       TransferRequestStatus @default(PENDING)

  requestedByName    String
  requestedByContact String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([tournamentId, status])
}

model Group {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String

  teams   Team[]
  matches Match[]
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  bracket  MatchBracket
  round    Int
  position Int

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  homeTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore Int?
  awayScore Int?
  status    MatchStatus @default(SCHEDULED)

  scheduledAt DateTime?
  venueId     String?
  venue       Venue?    @relation(fields: [venueId], references: [id])

  winnerNextMatchId String?
  winnerNextMatch   Match?     @relation("WinnerAdvance", fields: [winnerNextMatchId], references: [id])
  winnerNextSlot    MatchSlot?

  loserNextMatchId String?
  loserNextMatch   Match?     @relation("LoserAdvance", fields: [loserNextMatchId], references: [id])
  loserNextSlot    MatchSlot?

  isReset Boolean @default(false)

  incomingAsWinner Match[] @relation("WinnerAdvance")
  incomingAsLoser  Match[] @relation("LoserAdvance")

  goals            Goal[]
  cards            Card[]
  sets             MatchSet[]
  baskets          Basket[]
  fouls            Foul[]
  tableTennisGames TableTennisGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId, bracket, round])
}

model Goal {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  minute   Int
}

/// Used by the GOALS_CARDS family (minute) and by vôlei (setNumber) — exactly
/// one of the two is set, depending on the tournament's sport family.
model Card {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      CardType
  minute    Int?
  setNumber Int?
}

/// Vôlei: one row per set played in a match. Match.homeScore/awayScore for a
/// vôlei match is the count of sets won by each side, derived from these.
model MatchSet {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber  Int
  homePoints Int
  awayPoints Int

  @@unique([matchId, setNumber])
}

/// Basquete: one row per basket scored. Match.homeScore/awayScore is the sum
/// of `points` per side — this is what "artilharia" ranks by for basquete.
model Basket {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points   Int
  period   Int
}

/// Basquete: personal fouls, tracked per player instead of cards.
model Foul {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  period   Int
}

/// Tênis de mesa: a match ("confronto") is a tie of individual games, each
/// between one player per side (simples) or two (duplas). Match.homeScore/
/// awayScore is the count of games won by each side.
model TableTennisGame {
  id            String     @id @default(cuid())
  matchId       String
  match         Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber    Int
  homePlayerIds String[]
  awayPlayerIds String[]
  winnerSide    MatchSlot?

  sets TableTennisSet[]

  @@unique([matchId, gameNumber])
}

model TableTennisSet {
  id         String          @id @default(cuid())
  gameId     String
  game       TableTennisGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  setNumber  Int
  homePoints Int
  awayPoints Int

  @@unique([gameId, setNumber])
}

/// One chat session with the site's AI assistant widget (public visitor,
/// no login). Grouped by conversationId so the organizer can read a whole
/// exchange, not just isolated messages.
model AssistantConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistantMessage[]
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String                @db.Text
  createdAt      DateTime              @default(now())

  @@index([conversationId])
}
